{
	"git": {
		"requireBranch": "main",
		"requireCleanWorkingDir": true,
		"requireUpstream": true,
		"requireCommits": true,
		"commit": true,
		"tag": true,
		"push": true
	},
	"github": {
		"release": true
	},
	"npm": {
		"publish": false
	},
	"hooks": {
		"before:init": "npm run lint && npm test && npm run build"
	}
}
