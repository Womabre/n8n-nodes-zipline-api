{
	"git": {
		"requireBranch": "main",
		"requireCleanWorkingDir": true,
		"requireUpstream": true,
		"requireCommits": true,
		"commit": true,
		"tag": true,
		"push": true
	},
	"github": {
		"release": true,
		"releaseName": "${version}",
		"releaseNotes": "awk '/^## \\[${version}\\]/{f=1;next} /^## \\[|^\\[/{f=0} f' CHANGELOG.md"
	},
	"npm": {
		"publish": false
	},
	"hooks": {
		"before:init": "npm run lint && npm test && npm run build"
	}
}
