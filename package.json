{
	"name": "n8n-nodes-zipline-api",
	"version": "1.0.0",
	"publisher": "Womabre",
	"description": "n8n community node for interacting with the Zipline API",
	"license": "MIT",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"zipline",
		"file sharing",
		"file upload"
	],
	"homepage": "https://github.com/Womabre/n8n-nodes-zipline-api",
	"author": {
		"name": "Wouter Breedveld",
		"email": "w.m.breedveld@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Womabre/n8n-nodes-zipline-api.git"
	},
	"engines": {
		"node": ">=20.15"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"format": "prettier nodes credentials --write",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "release-it",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/ZiplineCookieApi.credentials.js",
			"dist/credentials/ZiplineTokenApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/ZiplineApi/ZiplineApi.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.36.1",
		"@types/node": "^24.1.0",
		"@typescript-eslint/eslint-plugin": "^8.59.3",
		"@typescript-eslint/parser": "^8.59.3",
		"@vitest/coverage-v8": "^4.1.2",
		"eslint": "9.29.0",
		"eslint-plugin-n8n-nodes-base": "^1.16.3",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"typescript": "5.9.2",
		"vitest": "^4.1.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
